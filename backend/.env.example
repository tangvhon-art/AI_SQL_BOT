# ===== 元数据库（MySQL AI_Infra）=====
# 默认使用 MySQL；如本机无 MySQL 服务，设置 DATABASE_URL=sqlite:///./ai_infra.db 降级运行（开发模式）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234qwer!@#$
DB_NAME=AI_Infra
DATABASE_URL=

# ===== 安全 =====
SECRET_KEY=change-me-to-a-random-32-bytes-base64
JWT_EXPIRE_MINUTES=1440

# ===== LLM（OpenAI 兼容，任一可用即可）=====
# 示例：DeepSeek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBED_MODEL=text-embedding-3-small
# 未配置 LLM 时系统进入 mock 演示模式（返回示例 SQL/文本）

# ===== 向量库（可选）=====
VECTOR_BACKEND=builtin   # builtin(内置演示) | milvus | chroma（预留）
VECTOR_COLLECTION_PREFIX=ai_sql_bot

# ===== 其他 =====
CORS_ORIGINS=*
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=1000
SQL_CORRECT_RETRIES=2
